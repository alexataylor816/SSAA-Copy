SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
# SQLite path for local dev; switch to a MySQL/RDS client on AWS prod.
DATABASE_PATH=./ssaa.db
CORS_ORIGINS=*
# Leave UPLOAD_DIR empty to use backend/uploads by default
UPLOAD_DIR=
PORT=8000

# Password-reset emails. Get a free key at https://resend.com/api-keys
# (no domain verification needed to send from the onboarding@resend.dev
# sandbox address below). Without a key, reset codes are logged to the
# server console and echoed as `devCode` in the API response instead.
RESEND_API_KEY=
EMAIL_FROM=SSAA <onboarding@resend.dev>
