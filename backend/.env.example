SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
# Database: "sqlite" (default) or "mysql". Keep sqlite until every file is converted.
DB_CLIENT=sqlite
# SQLite file (used when DB_CLIENT=sqlite)
DATABASE_PATH=./ssaa.db
# MySQL login (used when DB_CLIENT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ssaa_dev
MYSQL_PASSWORD=devpassword
MYSQL_DATABASE=ssaa
CORS_ORIGINS=*
# Leave UPLOAD_DIR empty to use backend/uploads by default
UPLOAD_DIR=
PORT=8000

# Password-reset and username emails. Option 1 (used first when set): Gmail.
# Turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and paste it below. Mail is sent
# from SMTP_USER to any address (~500/day).
SMTP_USER=
SMTP_PASS=

# Option 2: Resend (https://resend.com/api-keys). The onboarding@resend.dev
# sandbox sender only delivers to the Resend account owner's own address;
# reaching anyone else needs a verified domain and a matching EMAIL_FROM.
# The original app sent as "SSAA <noreply@ssaainc.com>": once ssaainc.com is
# verified at https://resend.com/domains (needs DNS access to that domain),
# set EMAIL_FROM to that and leave SMTP_USER/SMTP_PASS blank.
# With neither option, reset codes are logged to the server console and, in
# development only, shown on screen.
RESEND_API_KEY=
EMAIL_FROM=SSAA <onboarding@resend.dev>

# "Continue with Google" (POST /auth/google). Create an OAuth client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application),
# add http://localhost:8082 to its authorized JavaScript origins, then set this AND the
# matching VITE_GOOGLE_CLIENT_ID in web/.env. Without both, the Google
# button renders disabled and the endpoint returns 503.
GOOGLE_CLIENT_ID=
