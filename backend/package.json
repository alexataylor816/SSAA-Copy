{
  "name": "ssaa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:sqlite": "cross-env DB_CLIENT=sqlite tsx watch src/server.ts",
    "dev:mysql": "cross-env DB_CLIENT=mysql tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:mysql": "cross-env DB_CLIENT=mysql MYSQL_DATABASE=ssaa_test vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.15",
    "resend": "^6.31.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
